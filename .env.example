# Copia este archivo como .env.local y llena los valores.
# .env.local está en .gitignore: nunca se sube al repositorio.

# --- Supabase -------------------------------------------------------------
# Settings → API en el panel de Supabase.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave secreta (service_role / sb_secret_...). SOLO servidor: no lleva
# prefijo NEXT_PUBLIC_ porque ignora las políticas RLS.
SUPABASE_SECRET_KEY=

# --- Claude ---------------------------------------------------------------
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# --- Correo (Resend) ------------------------------------------------------
# resend.com → API Keys
RESEND_API_KEY=
# Remitente verificado. Mientras no verifiques dcing.com puedes usar
# "DCing <onboarding@resend.dev>" para pruebas.
RESEND_FROM="DCing <onboarding@resend.dev>"
# Copia interna de cada solicitud (opcional).
NOTIFY_EMAIL=

# --- Panel administrativo -------------------------------------------------
# Contraseña para entrar a /admin.
ADMIN_PASSWORD=
# Cadena aleatoria larga para firmar la cookie de sesión.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# --- WhatsApp -------------------------------------------------------------
# Número del negocio al que escribe el cliente desde la cotización.
WHATSAPP_NEGOCIO=
# Envío automático por la API de WhatsApp Cloud de Meta. Sin estas tres, el
# sistema solo genera el enlace wa.me y el envío lo da una persona.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Nombre de la plantilla aprobada por Meta. Sin plantilla solo se puede
# escribir a quien ya inició conversación en las últimas 24 horas.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=es_MX

# --- Sitio ----------------------------------------------------------------
# Dominio final. En Vercel se usa el de producción si no lo defines.
NEXT_PUBLIC_SITE_URL=
